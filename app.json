{
  "expo": {
    "name": "Aira",
    "slug": "aira",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.aira.app",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-dev-client",
      ["expo-image-picker", {
        "cameraPermission": "Gamitin ang camera para kunan ang resibo.",
        "photosPermission": "Pumili ng larawan ng resibo."
      }],
      "expo-asset"
    ]
  }
}
