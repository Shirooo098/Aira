    "speech:start": "expo start --dev-client --lan"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "expo": "57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-sqlite": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
