{
  "name": "aira",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/prepare-receipt-ocr.cjs",
    "receipt:prebuild": "node scripts/prepare-receipt-ocr.cjs && expo prebuild --platform android",
    "receipt:start": "expo start --dev-client --lan",
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "speech:model": "node scripts/prepare-speech-model.mjs",
    "speech:prebuild": "npx expo prebuild --platform android",
    "speech:start": "expo start --dev-client --lan",
    "agent:model": "node scripts/prepare-agent-model.mjs",
    "agent:prebuild": "expo prebuild --platform android",
    "agent:start": "expo start --dev-client --lan"
  },
  "dependencies": {
    "@react-native-ml-kit/text-recognition": "2.0.0",
    "buffer": "6.0.3",
    "expo": "57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-sqlite": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "whisper.rn": "0.7.4",
    "llama.rn": "0.12.9"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
